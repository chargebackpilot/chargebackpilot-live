{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm run lint && pnpm -r --if-present run build",
    "build:render": "pnpm --filter @workspace/db run push && BASE_PATH=/ pnpm --filter @workspace/chargeback-pilot run build && pnpm --filter @workspace/api-server run build",
    "seo:report": "pnpm --filter @workspace/chargeback-pilot run seo:report",
    "seo:gsc-report": "node scripts/gsc-report.mjs",
    "sync:reviews": "pnpm --filter @workspace/chargeback-pilot run sync:reviews",
    "audit:lighthouse": "pnpm --filter @workspace/chargeback-pilot run audit:lighthouse",
    "audit:unlighthouse": "pnpm --filter @workspace/chargeback-pilot run audit:unlighthouse",
    "start": "pnpm --filter @workspace/api-server run start",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "lint": "eslint . --ext .ts,.tsx --cache",
    "lint:fix": "eslint . --ext .ts,.tsx --cache --fix",
    "lint-staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install || true"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@unlighthouse/cli": "^0.17.10",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.8.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.4.0",
    "lint-staged": "^15.2.12",
    "prettier": "^3.8.3",
    "puppeteer": "^25.1.0",
    "typescript": "~5.9.3"
  }
}
