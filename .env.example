# ============================================================================
# ENVIRONMENT CONFIGURATION
# ChargebackPilot - Production & Development Settings
# ============================================================================
# 
# IMPORTANT SECURITY NOTES:
# 1. NEVER commit .env files - use .env.example as template
# 2. ADMIN_PASSWORD must be at least 15 characters
# 3. Use strong, random passwords generated by password managers
# 4. Rotate secrets regularly (every 90 days minimum)
# 5. Keep GEMINI_API_KEY and STRIPE_SECRET_KEY private
#

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV=development
LOG_LEVEL=info

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=3000
BASE_PATH=/

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================
# Format: postgresql://user:password@host:port/database?sslmode=require
# For local development: postgresql://user:password@localhost:5432/chargeback
DATABASE_URL=postgresql://user:password@localhost:5432/chargeback?sslmode=require

# ============================================================================
# ADMIN PANEL SECURITY
# ============================================================================
# Generate with: openssl rand -hex 24
# Must be at least 15 characters
ADMIN_PASSWORD=your_secure_password_here_at_least_15_chars

# ============================================================================
# AI ANALYSIS (Google Gemini)
# ============================================================================
# Get API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_FALLBACK=your_fallback_gemini_api_key_here

# ============================================================================
# PAYMENT PROCESSING (Stripe)
# ============================================================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ============================================================================
# BOT PROTECTION (Cloudflare Turnstile)
# ============================================================================
# Get from: https://dash.cloudflare.com/turnstile
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here
TURNSTILE_AFTER_ATTEMPTS=2
REQUIRE_TURNSTILE_ON_CASE_CREATE=1

# ============================================================================
# RATE LIMITING
# ============================================================================
# Time window for case creation limit (in milliseconds)
CASE_CREATE_WINDOW_MS=3600000
# Maximum cases per IP per time window
CASE_CREATE_LIMIT_PER_WINDOW=10
# Maximum successful free analyses per IP per rolling 24 hours
CASE_CREATE_DAILY_LIMIT_PER_IP=3
# Cheap input quality gates before Turnstile/Gemini
CASE_DESCRIPTION_MIN_CHARS=80
CASE_DESCRIPTION_MAX_CHARS=6000

# ============================================================================
# DATA RETENTION
# ============================================================================
# Automatically anonymize old cases and delete old first-party analytics events
CASE_RETENTION_MONTHS=12
ANALYTICS_RETENTION_MONTHS=12

# ============================================================================
# FRONTEND
# ============================================================================
VITE_API_BASE_URL=/api
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
